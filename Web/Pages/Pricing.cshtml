@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pricing — Tally</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Inter, system-ui, sans-serif; color: #37352F; }
        header { height: 60px; display: flex; justify-content: space-between; align-items: center; padding: 0 24px; }
        .logo img { height: 28px; }
        .nav a { margin-left: 12px; font-weight: 600; font-size: 14px; color: #777672; text-decoration: none; }
        .nav a.primary { background: #0070D7; color: #fff; padding: 8px 14px; border-radius: 8px; }
        .container { max-width: 1000px; margin: 0 auto; padding: 60px 24px; text-align: center; }
        h1 { font-size: 48px; margin-bottom: 12px; }
        .sub { font-size: 18px; color: #5F5E5A; margin-bottom: 48px; }
        .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 800px; margin: 0 auto; }
        @@media (max-width: 700px) { .plans { grid-template-columns: 1fr; } }
        .plan { border: 1px solid #eaeaea; border-radius: 12px; padding: 32px; text-align: left; background: #fff; }
        .plan.pro { border: 2px solid #F81CE5; box-shadow: 0 0 0 4px rgba(248,28,229,0.15); }
        .plan h2 { font-size: 24px; margin-bottom: 8px; }
        .price { font-size: 40px; font-weight: 800; margin: 16px 0; }
        .price span { font-size: 16px; font-weight: 500; color: #777; }
        ul { list-style: none; margin: 24px 0; }
        li { padding: 8px 0; font-size: 15px; }
        li:before { content: "✓ "; color: #20c933; font-weight: bold; }
        .btn { display: block; text-align: center; background: #0070D7; color: #fff; padding: 12px; border-radius: 8px; text-decoration: none; font-weight: 600; }
        .btn.black { background: #000; }
        .btn:hover { opacity: 0.9; }
        .note { margin-top: 40px; font-size: 14px; color: #777; }
    </style>
</head>
<body>
    <header>
        <a href="/" class="logo"><img src="https://tally.so/images/logo_v2.png" alt="Tally" /></a>
        <div class="nav">
            <a href="/">Home</a>
            <a href="/create" class="primary">Create form</a>
        </div>
    </header>
    <div class="container">
        <h1>Simple, transparent pricing</h1>
        <p class="sub">Start for free. Upgrade when you need more power.</p>
        <div class="plans">
            <div class="plan">
                <h2>Free</h2>
                <p>For individuals &amp; small projects</p>
                <div class="price">$0 <span>/ forever</span></div>
                <ul>
                    <li>Unlimited forms</li>
                    <li>Unlimited submissions (fair use)</li>
                    <li>All input blocks</li>
                    <li>Conditional logic</li>
                    <li>File uploads (10 MB)</li>
                    <li>Basic integrations</li>
                    <li>GDPR compliant</li>
                </ul>
                <a href="/create" class="btn">Get started free</a>
            </div>
            <div class="plan pro">
                <h2>Pro</h2>
                <p>For growing teams &amp; creators</p>
                <div class="price">$29 <span>/ month</span></div>
                <ul>
                    <li>Everything in Free</li>
                    <li>Remove Tally branding</li>
                    <li>Custom domains</li>
                    <li>Team collaboration</li>
                    <li>Partial submissions</li>
                    <li>Unlimited file uploads</li>
                    <li>Custom CSS &amp; email notifications</li>
                    <li>Priority support</li>
                </ul>
                <a href="/signup" class="btn black">Upgrade to Pro</a>
            </div>
        </div>
        <p class="note">This is a demo clone of Tally.so pricing page. Real pricing and features may differ.</p>
    </div>
</body>
</html>
